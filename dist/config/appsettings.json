{
  "timeouts": {
    "connectSeconds": 5,
    "requestSeconds": 10,
    "candidateSeconds": 20,
    "stabilizationMilliseconds": 800,
    "handshakeMilliseconds": 800
  },
  "search": {
    "mode": "Fast",
    "maxCandidates": 48,
    "maxStage2PerStrategy": 8,
    "allowDnsChanges": false,
    "allowRoutingChanges": false,
    "repeatSuccessProbes": 2
  },
  "monitor": {
    "intervalSeconds": 60,
    "autoRediscover": true
  },
  "zapret": {
    "startupMilliseconds": 1200
  }
}
