{
  "timeouts": {
    "connectSeconds": 5,
    "requestSeconds": 10,
    "candidateSeconds": 20,
    "stabilizationMilliseconds": 800,
    "handshakeMilliseconds": 800
  },
  "search": {
    "mode": "Fast",
    "maxCandidates": 84,
    "maxStage2PerStrategy": 8,
    "allowDnsChanges": true,
    "allowRoutingChanges": true,
    "repeatSuccessProbes": 2
  },
  "monitor": {
    "intervalSeconds": 60,
    "autoRediscover": true
  },
  "dpi": {
    "enabled": true,
    "listenAddress": "127.0.0.1"
  }
}
